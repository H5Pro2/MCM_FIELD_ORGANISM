  "findings": [
    {
      "id": "EY-B01",
      "priority": 1,
      "title": "Path API output handling attempts integer conversion of a pathname",
      "sources": [
        {
          "path": "mcm_field_organism/_s2ex_recorder_native.py",
          "start": 32,
          "end": 33
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_native.py",
          "start": 152,
          "end": 161
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_native.py",
          "start": 225,
          "end": 242
        },
        {
          "path": "mcm_field_organism/_s2er_windows_files.py",
          "start": 126,
          "end": 136
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_supervisor.py",
          "start": 142,
          "end": 148
        }
      ],
      "contract_refs": [
        "S2-EU.recorder.call_pairs",
        "S2-EU.recorder.output_contents",
        "S2-EW.directory_derivation.drive_query"
      ],
      "static_derivation": "pin_parents calls GetDriveTypeW with a canonical drive-root string. NativeRecorder.invoke then calls _outputs, which attempts number(args[0]) except for CreateFileW. int of that pathname raises before CALL_RETURN. GetFileAttributesW has the same defect.",
      "consequence": "After a future explicit unlock, the first parent pin cannot complete its trace; no isolated case can be admitted.",
      "required_correction": "Serialize pathname-based return-only APIs without resolving a numeric handle; preserve all existing APIs and backend code.",
      "executed": false
    },
    {
      "id": "EY-B02",
      "priority": 1,
      "title": "Read-only trace acceptance does not require the complete native case evidence",
      "sources": [
        {
          "path": "mcm_field_organism/_s2ex_recorder_trace.py",
          "start": 20,
          "end": 59
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_trace.py",
          "start": 163,
          "end": 262
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_trace.py",
          "start": 265,
          "end": 290
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_fixture.py",
          "start": 108,
          "end": 116
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_supervisor.py",
          "start": 249,
          "end": 251
        },
        {
          "path": "mcm_field_organism/_s2ex_recorder_supervisor.py",
          "start": 278,
          "end": 286
        }
      ],
      "contract_refs": [
        "S2-EU.recorder.phases",
        "S2-EU.recorder.source_binding",
        "S2-EU.type_rules.trace_events",
        "S2-EU.atomic_recording.sequence",
        "S2-EW.call_binding"
      ],
      "static_derivation": "For p01, inspect_entries requires confirmed phase markers and four True checks, but no native operation. Empty returns/injected/cleanup lists satisfy its positive predicates. Entry schema literals, full event-specific null/output rules, path/handle lifecycles and native evidence-to-phase relations are not fully checked.",
      "symbolic_counterexample": {
        "kind": "PROSE_ONLY_NOT_MATERIALIZED",
        "description": "A correctly bound header, nine ordered phase begin/end pairs with True, sources-unchanged/case-postconditions/helper.before-rename/helper.after-rename True checks, terminal COMPLETED and a matching recomputed footer satisfy current p01 predicates without any CALL_BEGIN/CALL_RETURN."
      },
      "additional_limit": "The fixture postconditions do not reread p09 final or p11 marker bytes after their injected flush failures. No observed readability may be inferred from generic checks.",
      "consequence": "matched and subsequent OBSERVED_COMPLETE are not sufficient independent evidence of all required operations; source hashes alone do not close this acceptance gap.",
      "required_correction": "Apply the existing closed schemas and reconstruct existing case/phase obligations, path ownership, handles, output slots, permitted faults and stop boundaries from original entries.",
      "executed": false
    },
    {
      "id": "EY-B03",
      "priority": 2,
      "title": "Unbound new control payload schema",
      "sources": [
        {
          "path": "mcm_field_organism/_s2ex_recorder_supervisor.py",
          "start": 65,
          "end": 111
        }
      ],
      "contract_refs": [
        "S2-EU.recorder.separation",
        "S2-EW.global_lifecycle_rules"
      ],
      "static_derivation": "ControlTrace introduces s2ex.control-entry.v1 with an unrestricted fields payload and no independent closed-form reader. S2-EW explicitly excludes a new control payload schema.",
      "consequence": "The separate control channel exists, but its new representation cannot be treated as contractually admitted.",
      "required_correction": "First bind a narrow contract-conformant representation and acceptance for the already-required control channel. Do not silently ratify schema drift or introduce a new witness/marker protocol.",
      "executed": false
    },
