  "findings": [
    {
      "id": "EP-B01",
      "status": "OPEN",
      "category": "PRIVATE_PLAN_AND_RECORD_BINDING",
      "title": "Private plan wrapper, target reservation and new identity/marker forms are not fully bound",
      "references": [
        {
          "path": "docs/S2EO_STATISCHER_DATEIBEZOGENER_VEROEFFENTLICHUNGSVERTRAG.md",
          "lines": [
            48,
            77,
            147
          ]
        },
        {
          "path": "docs/S2EO_STATISCHER_DATEIBEZOGENER_VEROEFFENTLICHUNGSVERTRAG_V1.json",
          "json_roles": [
            "namespace",
            "completion_marker.fields"
          ]
        },
        {
          "path": "mcm_field_organism/_tspm1_s2dr_private_comparison.py",
          "symbols": [
            "S2EFRecord.payload",
            "_build_s2ef_execution_plan",
            "_validate_execution_sources",
            "_S2EFAttempt._verify_completion"
          ]
        }
      ],
      "observation": "S2-EO requires additional source-bound volume, parent, backend and platform data. Existing ExecutionPlan is exact-source-validated and does not currently bind them; no separate private binding carrier is specified. Target reservation has no complete schema; marker has 19 field names but new nested identity forms are not fully typed or version-bound.",
      "risk": "Implementation would need to choose new provenance and digest relations not settled by the contract; matching self-digests would not establish authorized source identity.",
      "static_counterexample": "Two different external platform/parent bindings can refer to the same unchanged inner plan; the private admission rule linking one binding to authorization is not specified.",
      "closure": "Statically define the private plan wrapper, target reservation, identity and marker schemas, sources, directed digest links and relational rejection conditions without modifying the inner plan or public/core contracts.",
      "executed_counterexample": false
    },
    {
      "id": "EP-B02",
      "status": "OPEN",
      "category": "PLATFORM_EVIDENCE_ADMISSION",
      "title": "Platform and parent-durability evidence lacks a complete admission contract",
      "references": [
        {
          "path": "docs/S2EO_STATISCHER_DATEIBEZOGENER_VEROEFFENTLICHUNGSVERTRAG.md",
          "lines": [
            42,
            131,
            209,
            211,
            218
          ]
        },
        {
          "path": "docs/S2EO_STATISCHER_DATEIBEZOGENER_VEROEFFENTLICHUNGSVERTRAG_V1.json",
          "json_roles": [
            "completion_marker.fields.platform_acceptance_digest",
            "acceptance_gates"
          ]
        }
      ],
      "observation": "E0 and G1/G2/G5 require accepted platform and durable-parent evidence but do not define its exact form, origin, backend/domain applicability and complete acceptance/rejection predicate.",
      "risk": "A readable, digest-valid diagnostic report or evidence from another backend/directory must not satisfy publication durability preconditions.",
      "static_counterexample": "A complete report from another backend or parent can claim the abstract evidence role; the exact source/domain admission predicate remains undefined.",
      "closure": "Bind evidence form, provenance, applicability and acceptance conditions; map reservation names, record names and rename metadata to documented guarantees and later isolated observations. Reject missing, foreign, partial and readability-only evidence.",
      "not_a_finding": "Absence of future platform measurements is expected and is not itself a static audit failure.",
      "executed_counterexample": false
    }
  ],
